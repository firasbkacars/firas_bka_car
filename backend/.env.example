APP_NAME="FIRAS BKA CAR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=firas_bka_car
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="firasbkacars@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des notifications internes (reservations, contact, alertes).
# Distinct de MAIL_FROM_ADDRESS pour ne pas detourner les alertes si
# l'expediteur change.
MAIL_ADMIN_ADDRESS="firasbkacars@gmail.com"

# Gmail : MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_SCHEME=smtp, MAIL_USERNAME=firasbkacars@gmail.com et
# MAIL_PASSWORD = mot de passe d'application Google (16 caracteres),
# jamais le mot de passe du compte.

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_API_VERSION=v17.0
WHATSAPP_APP_SECRET=

# CMI Payment (Maroc)
# CMI_MODE=sandbox (passerelle simulee) ou production (contrat API requis)
CMI_MODE=sandbox
CMI_MERCHANT_KEY=
CMI_MERCHANT_SECRET=sandbox-secret
CMI_RETURN_URL=http://localhost:8000/api/cmi/callback
CMI_CANCEL_URL=http://localhost:8000/api/cmi/cancel
CMI_NOTIFY_URL=http://localhost:8000/api/cmi/webhook
# URLs de la passerelle (defaut : production CMI, a surcharger en sandbox)
CMI_GATEWAY_URL=https://pay.cmi.co.ma/api/payment/init
CMI_STATUS_URL=https://pay.cmi.co.ma/api/payment/status
CMI_REFUND_URL=https://pay.cmi.co.ma/api/payment/refund

# Storage
MEDIA_DISK=public

# Frontend URL (for CORS, links in emails)
FRONTEND_URL=http://localhost:5173

# Sentry (monitoring des erreurs) - https://sentry.io
# Laisser vide pour desactiver l'envoi d'erreurs.
SENTRY_DSN=
# Taux d'echantillonnage des traces de performance (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ENVIRONMENT=

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api

# M2 : seuil (ms) au-dela duquel une requete est journalisee comme lente
SLOW_REQUEST_MS=500
